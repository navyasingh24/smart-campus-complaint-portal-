# Local development configuration for the backend.
# Copy this file to backend/.env and adjust. Never commit backend/.env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Generate your own value with:  openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# "local" stores data in backend/data/local-db.json (no AWS account needed).
# "dynamodb" uses Amazon DynamoDB (or DynamoDB Local when DYNAMODB_ENDPOINT is set).
DB_DRIVER=local

# Only used when DB_DRIVER=dynamodb
AWS_REGION=us-east-1
USERS_TABLE=scc-users
COMPLAINTS_TABLE=scc-complaints
# DYNAMODB_ENDPOINT=http://localhost:8000

# Locally the site runs over plain HTTP, so secure cookies must be off.
COOKIE_SECURE=false

# Optional: create an administrator automatically at start-up (used on hosts
# without shell access such as Render). Password: at least 12 characters with
# a letter and a number. Leave empty to use "npm run create-admin" instead.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Extra origins allowed to call the API from a browser (comma-separated).
# Leave empty: the Vite dev server proxies /api, so everything is same-origin.
CORS_ORIGINS=
